---
import type { ArticleRef } from '../data/types';

interface Props {
  article: ArticleRef | null | undefined;
}
const { article } = Astro.props;
---
{
  article && (
    <p class="source">
      Forrás: <a href={article.url}>{article.lang === 'en' ? 'Wikipedia (angol)' : 'Wikipédia'} – {article.title}</a>
      {' · '}
      <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.hu">CC BY-SA 4.0</a>
    </p>
  )
}
