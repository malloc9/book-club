---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Credit from '../../components/Credit.astro';
import Source from '../../components/Source.astro';
import EnBadge from '../../components/EnBadge.astro';
import Blocks from '../../components/Blocks.astro';
import { books, asset, bookUrl } from '../../data/books';
import type { BookData, Work } from '../../data/types';
import WorkItem from '../../components/WorkItem.astro';

export function getStaticPaths() {
  return books.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props as { b: BookData };
const book = b.book;
const author = b.author;
const f = book?.facts;
const af = author?.facts;

const place = (when: string | null | undefined, where: string | null | undefined) =>
  [when, where].filter(Boolean).join(', ');
// Works the club has read link to our own book page.
// Works the club has read link to our own book page (by Wikidata id or by title).
const normT = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
const clubById = new Map(books.filter((x) => x.book?.wikidataId).map((x) => [x.book!.wikidataId!, x.slug]));
const clubByTitle = new Map(books.map((x) => [normT(x.title), x.slug]));
const oursOf = (w: Work) => {
  const slug = w.clubTitle ? b.slug : (w.wikidataId && clubById.get(w.wikidataId)) || clubByTitle.get(normT(w.title));
  return slug ? bookUrl(slug) : null;
};
const WORKS_SHOWN = 20;
const firstPara = book?.intro.find((x) => typeof x === 'string' || x.type === 'rich');
const description = (typeof firstPara === 'string'
  ? firstPara
  : firstPara?.type === 'rich'
    ? firstPara.parts.map((p) => (typeof p === 'string' ? p : p.text)).join('')
    : undefined
)?.slice(0, 160);
const born = place(af?.birth, af?.birthPlace);
const died = place(af?.death, af?.deathPlace);
---
<Base title={b.title} description={description}>
  <a class="back" href={asset('')}>← Vissza a könyvekhez</a>

  <article class="book">
    <header class="book-hero">
      <figure class="hero-cover">
        <Cover image={book?.cover} title={b.title} author={b.authorName} eager />
        <figcaption><Credit image={book?.cover} /></figcaption>
      </figure>
      <div class="hero-text">
        <p class="eyebrow">{b.authorName}</p>
        <h1>{b.title}</h1>
        {f?.originalTitle && f.originalTitle !== b.title && <p class="original-title">{f.originalTitle}</p>}
        {
          f && (
            <dl class="facts">
              {f.published && (<div><dt>Első megjelenés</dt><dd>{f.published}</dd></div>)}
              {f.language && (<div><dt>Eredeti nyelv</dt><dd>{f.language}</dd></div>)}
              {f.country && (<div><dt>Ország</dt><dd>{f.country}</dd></div>)}
              {f.genres.length > 0 && (<div><dt>Műfaj</dt><dd>{f.genres.join(', ')}</dd></div>)}
              {f.publisher && (<div><dt>Kiadó</dt><dd>{f.publisher}</dd></div>)}
              {f.pages && (<div><dt>Terjedelem</dt><dd>{f.pages} oldal</dd></div>)}
              {f.awards && f.awards.length > 0 && (<div><dt>Díj</dt><dd>{f.awards.join(', ')}</dd></div>)}
            </dl>
          )
        }
      </div>
    </header>

    {
      book && book.intro.length > 0 ? (
        <section class="prose">
          <h2>
            A könyvről
            {book.introManual ? (
              <span class="badge" title="Erről a könyvről nincs Wikipédia-szócikk; ez a leírás az alább felsorolt források alapján készült.">
                összefoglaló több forrás alapján
              </span>
            ) : book.introFromAuthor ? (
              <span class="badge" title="Erről a könyvről nincs külön Wikipédia-szócikk; ezek a szerző szócikkének a könyvet említő bekezdései.">
                a szerző szócikkéből
              </span>
            ) : (
              <EnBadge article={book.article} />
            )}
          </h2>
          <Blocks blocks={book.intro} />
          {book.plot && (
            <details class="spoiler">
              <summary>Cselekmény – <strong>spoilert tartalmaz</strong>, kattints a megjelenítéshez</summary>
              <div class="spoiler-body"><Blocks blocks={book.plot} /></div>
            </details>
          )}
          {book.introManual ? (
            <p class="source">
              Források:{' '}
              {book.sources?.map((src, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={src.url}>{src.name}</a>
                </>
              ))}
            </p>
          ) : (
            <Source article={book.introFromAuthor ? author?.article : book.article} />
          )}
        </section>
      ) : (
        <section class="prose">
          <h2>A könyvről</h2>
          <p class="muted">
            Erről a könyvről még nincs Wikipédia-szócikk, és a szerző szócikke sem ír róla részletesebben.
            A szerzőről alább olvashatsz.
          </p>
        </section>
      )
    }

    {
      author && (
        <section class="author">
          <h2>A szerzőről <EnBadge article={author.article} /></h2>
          <div class="author-grid">
            <figure class="portrait-fig">
              {author.portrait ? (
                <img
                  class="portrait"
                  src={asset(author.portrait.src)}
                  width={author.portrait.width}
                  height={author.portrait.height}
                  alt={author.name}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="portrait portrait-placeholder" aria-hidden="true">{author.name.charAt(0)}</div>
              )}
              <figcaption><Credit image={author.portrait} /></figcaption>
            </figure>
            <div class="author-body">
              <h3>{author.name}</h3>
              <dl class="facts compact">
                {born && (<div><dt>Született</dt><dd>{born}</dd></div>)}
                {died && (<div><dt>Elhunyt</dt><dd>{died}</dd></div>)}
                {af && af.nationality.length > 0 && (<div><dt>Állampolgárság</dt><dd>{af.nationality.join(', ')}</dd></div>)}
                {af && af.occupations.length > 0 && (<div><dt>Foglalkozás</dt><dd>{af.occupations.join(', ')}</dd></div>)}
              </dl>
              <div class="prose"><Blocks blocks={author.intro} /></div>
            </div>
          </div>

          {author.biography?.length > 0 && (
            <div class="prose bio">
              <h3 class="sub">Életrajz <EnBadge article={author.biographyArticle} /></h3>
              {author.biography.map((s) => (
                <>
                  {s.level <= 1 ? <h4>{s.heading}</h4> : <h5>{s.heading}</h5>}
                  <Blocks blocks={s.paras} />
                </>
              ))}
              {author.biographyArticle && <Source article={author.biographyArticle} />}
            </div>
          )}

          {author.works?.length > 0 && (
            <div class="works-block">
              <h3 class="sub">Művei</h3>
              <ol class="works">
                {author.works.slice(0, WORKS_SHOWN).map((w) => <WorkItem w={w} ours={oursOf(w)} />)}
              </ol>
              {author.works.length > WORKS_SHOWN && (
                <details class="more-works">
                  <summary>További {author.works.length - WORKS_SHOWN} mű megjelenítése</summary>
                  <ol class="works">
                    {author.works.slice(WORKS_SHOWN).map((w) => <WorkItem w={w} ours={oursOf(w)} />)}
                  </ol>
                </details>
              )}
              <p class="source">
                Forrás: a szerző Wikipédia-szócikkének műjegyzéke és a{' '}
                <a href={`https://www.wikidata.org/wiki/${author.wikidataId}`}>Wikidata</a>.
              </p>
            </div>
          )}

          {author.huEditions && (
            <div class="editions-block">
              <h3 class="sub">Magyarul megjelent</h3>
              <ul class="editions">{author.huEditions.map((e) => <li>{e}</li>)}</ul>
            </div>
          )}

          <Source article={author.article} />
        </section>
      )
    }
  </article>
</Base>
